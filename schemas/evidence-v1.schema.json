{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:researchauditkit:evidence:v1",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "researchauditkit.evidence/v1",
  "description": "Explicit graph or CLI result. Additional CLI semantic checks enforce exact version identity, nonfloating versions, typed endpoints/references, cycles, budgets, filesystem confinement and stable byte identity. Input labels are declarations, not scientific adjudication.",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "logical_id",
            "version",
            "type",
            "assertion_level",
            "statement",
            "resolution"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 641
            },
            "logical_id": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^urn:rak:[A-Za-z0-9_.-]+:claim:[A-Za-z0-9_.:-]+$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "not": {
                "enum": [
                  "latest",
                  "current",
                  "head",
                  "main",
                  "master",
                  "LATEST",
                  "CURRENT",
                  "HEAD",
                  "MAIN",
                  "MASTER"
                ]
              }
            },
            "type": {
              "const": "Claim"
            },
            "assertion_level": {
              "enum": [
                "DECLARED",
                "MECHANICALLY_VERIFIED",
                "SCIENTIFICALLY_ADJUDICATED"
              ]
            },
            "external_adjudication": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "record_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "resolution": {
              "enum": [
                "ABSTAIN",
                "EXTERNAL_ADJUDICATION_RECORDED",
                "UNRESOLVED"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "logical_id",
            "version",
            "type",
            "assertion_level",
            "description",
            "source_refs"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 641
            },
            "logical_id": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^urn:rak:[A-Za-z0-9_.-]+:evidence:[A-Za-z0-9_.:-]+$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "not": {
                "enum": [
                  "latest",
                  "current",
                  "head",
                  "main",
                  "master",
                  "LATEST",
                  "CURRENT",
                  "HEAD",
                  "MAIN",
                  "MASTER"
                ]
              }
            },
            "type": {
              "const": "Evidence"
            },
            "assertion_level": {
              "enum": [
                "DECLARED",
                "MECHANICALLY_VERIFIED",
                "SCIENTIFICALLY_ADJUDICATED"
              ]
            },
            "external_adjudication": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "record_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "logical_id",
            "version",
            "type",
            "assertion_level",
            "protocol_ref",
            "execution_status",
            "record_refs"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 641
            },
            "logical_id": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^urn:rak:[A-Za-z0-9_.-]+:experimentrun:[A-Za-z0-9_.:-]+$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "not": {
                "enum": [
                  "latest",
                  "current",
                  "head",
                  "main",
                  "master",
                  "LATEST",
                  "CURRENT",
                  "HEAD",
                  "MAIN",
                  "MASTER"
                ]
              }
            },
            "type": {
              "const": "ExperimentRun"
            },
            "assertion_level": {
              "enum": [
                "DECLARED",
                "MECHANICALLY_VERIFIED",
                "SCIENTIFICALLY_ADJUDICATED"
              ]
            },
            "external_adjudication": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "record_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "protocol_ref": {
              "type": "string",
              "minLength": 1
            },
            "execution_status": {
              "enum": [
                "BLOCKED",
                "COMPLETED",
                "FAIL",
                "NOT_EXECUTED",
                "PARTIAL",
                "PASS",
                "UNRESOLVED"
              ]
            },
            "record_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "logical_id",
            "version",
            "type",
            "assertion_level",
            "path",
            "media_type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 641
            },
            "logical_id": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^urn:rak:[A-Za-z0-9_.-]+:artifact:[A-Za-z0-9_.:-]+$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "not": {
                "enum": [
                  "latest",
                  "current",
                  "head",
                  "main",
                  "master",
                  "LATEST",
                  "CURRENT",
                  "HEAD",
                  "MAIN",
                  "MASTER"
                ]
              }
            },
            "type": {
              "const": "Artifact"
            },
            "assertion_level": {
              "enum": [
                "DECLARED",
                "MECHANICALLY_VERIFIED",
                "SCIENTIFICALLY_ADJUDICATED"
              ]
            },
            "external_adjudication": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "record_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$)[^\\\\\\x00-\\x1f\\x7f]+$"
            },
            "media_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "unresolved_reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          },
          "anyOf": [
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "unresolved_reason"
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "logical_id",
            "version",
            "type",
            "assertion_level",
            "description"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 641
            },
            "logical_id": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^urn:rak:[A-Za-z0-9_.-]+:protocol:[A-Za-z0-9_.:-]+$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "not": {
                "enum": [
                  "latest",
                  "current",
                  "head",
                  "main",
                  "master",
                  "LATEST",
                  "CURRENT",
                  "HEAD",
                  "MAIN",
                  "MASTER"
                ]
              }
            },
            "type": {
              "const": "Protocol"
            },
            "assertion_level": {
              "enum": [
                "DECLARED",
                "MECHANICALLY_VERIFIED",
                "SCIENTIFICALLY_ADJUDICATED"
              ]
            },
            "external_adjudication": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "record_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "unresolved_reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          },
          "anyOf": [
            {
              "required": [
                "artifact_refs"
              ],
              "properties": {
                "artifact_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "unresolved_reason"
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "logical_id",
            "version",
            "type",
            "assertion_level",
            "outcome",
            "rationale"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 641
            },
            "logical_id": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^urn:rak:[A-Za-z0-9_.-]+:decision:[A-Za-z0-9_.:-]+$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "not": {
                "enum": [
                  "latest",
                  "current",
                  "head",
                  "main",
                  "master",
                  "LATEST",
                  "CURRENT",
                  "HEAD",
                  "MAIN",
                  "MASTER"
                ]
              }
            },
            "type": {
              "const": "Decision"
            },
            "assertion_level": {
              "enum": [
                "DECLARED",
                "MECHANICALLY_VERIFIED",
                "SCIENTIFICALLY_ADJUDICATED"
              ]
            },
            "external_adjudication": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "record_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "outcome": {
              "enum": [
                "GO",
                "NO_GO",
                "ABSTAIN",
                "UNRESOLVED"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "external_adjudication_ref": {
              "type": "string",
              "minLength": 1
            },
            "unresolved_reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          },
          "anyOf": [
            {
              "required": [
                "external_adjudication_ref"
              ]
            },
            {
              "required": [
                "unresolved_reason"
              ]
            }
          ]
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "type": {
          "enum": [
            "SUPPORTS",
            "CONTRADICTS",
            "DERIVED_FROM",
            "SUPERSEDES",
            "DEPENDS_ON"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "citation_context": {
          "enum": [
            "current",
            "historical"
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "nodes",
        "edges"
      ],
      "properties": {
        "schema": {
          "const": "researchauditkit.evidence/v1"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "command",
        "graph_content_sha256",
        "result_content_sha256",
        "status",
        "findings",
        "nodes_visited",
        "edges_visited",
        "reference_observations",
        "artifact_observations",
        "scope_limits"
      ],
      "properties": {
        "schema": {
          "const": "researchauditkit.evidence/v1"
        },
        "command": {
          "enum": [
            "validate",
            "trace",
            "doctor"
          ]
        },
        "graph_content_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "PASS",
            "INVALID",
            "UNRESOLVED"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "severity",
              "node_id",
              "path"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "severity": {
                "enum": [
                  "INFO",
                  "UNRESOLVED",
                  "INVALID"
                ]
              },
              "node_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "nodes_visited": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges_visited": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "reference_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "field"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "artifact_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "path",
              "declared_version",
              "expected_sha256",
              "status"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$)[^\\\\\\x00-\\x1f\\x7f]+$"
              },
              "declared_version": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "stable_read": {
                "const": true
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scope_limits": {
          "type": "object"
        }
      }
    }
  ]
}
