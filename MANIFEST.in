include README.md
include LICENSE
include LICENSE_STATUS.md
include PROJECT_STATUS.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include CITATION.cff
include action.yml
recursive-include action *.sh *.py
recursive-include configs *.yaml
recursive-include schemas *.json
recursive-include src *.py
prune audit
prune release_audit
prune tests
prune examples
prune docs
include docs/quickstart.md
include docs/audit_command.md
include docs/research_release_workflow.md
include docs/github_action.md
include docs/extension_boundaries.md
include docs/command_reference.md
include docs/use_cases.md
include docs/limitations.md
include docs/architecture.md
include docs/ci_integration.md
include docs/rc2_readiness.md
include docs/integrity_model.md
include docs/custody_isolation.md
include docs/support_audit.md
include docs/validation_audit.md
include docs/productization/EXISTING_PRODUCT_SURFACE.md
recursive-include docs/releases *.md
recursive-include examples/repository_integrity_demo *.md *.yaml *.py *.csv *.json
recursive-include examples/audit_demo *
global-exclude .DS_Store
global-exclude *.py[cod]
global-exclude *.pkl
global-exclude *.pickle
global-exclude *.tmp
